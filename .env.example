# All application data stays inside this directory. Never commit it.
STUDIO_DATA_DIR=./data
# Change both the backend command and this URL if using another port.
STUDIO_BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
# AI is disabled by default. Modes: disabled, local, external.
AI_MODE=disabled
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=
# Optional one-time startup import. The originals are never modified.
RESUME_DOCX=
RESUME_PDF=
